# Copy to .env and fill in. Do NOT commit .env.

# --- Bronto ingestion ---
# EU region endpoints base (use https://ingestion.us.bronto.io for US)
BRONTO_OTLP_BASE=https://ingestion.eu.bronto.io
BRONTO_API_KEY=replace-with-your-bronto-ingestion-key

# --- Second Bronto account (optional) ---
# The collector broadcasts every signal to both accounts. Leave blank to
# only export to the account above.
BRONTO_OTLP_BASE_2=
BRONTO_API_KEY_2=

# --- AWS / Bedrock ---
AWS_REGION=eu-west-1
# Local dev: name of the AWS CLI/SSO profile boto3 should use (blank = default chain)
AWS_PROFILE=
# Default uses Amazon Nova (Anthropic models may be gated on some account types).
BEDROCK_MODEL_ID=eu.amazon.nova-micro-v1:0
